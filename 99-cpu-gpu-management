# Permite ao usuário dikson executar comandos de gerenciamento de CPU/GPU sem senha
# Comandos relacionados a CPU governor
dikson ALL=(ALL) NOPASSWD: /usr/bin/bash -c for CPU in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor*
dikson ALL=(ALL) NOPASSWD: /usr/bin/tee /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor

# Comandos relacionados a permissões de arquivos do sistema
dikson ALL=(ALL) NOPASSWD: /usr/bin/chown dikson\:dikson /sys/class/powercap/intel-rapl\:0/energy_uj
dikson ALL=(ALL) NOPASSWD: /usr/bin/chown dikson\:dikson /sys/class/backlight/intel_backlight/brightness
dikson ALL=(ALL) NOPASSWD: /usr/bin/chmod 666 /mnt/.system_offload/log/pos_Blue_Brilho.log

# Leitura de estado de energia
dikson ALL=(ALL) NOPASSWD: /usr/bin/bash -c cat /sys/class/power_supply/ACAD/online

# Comandos de suspensão
dikson ALL=(ALL) NOPASSWD: /usr/bin/tee /proc/acpi/wakeup
dikson ALL=(ALL) NOPASSWD: /usr/bin/systemctl suspend
dikson ALL=(ALL) NOPASSWD: /usr/bin/systemctl suspend -i
